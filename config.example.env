# 复制为 .env 后按需修改；本文件仅含占位/演示值，不是真实凭证
# 会话签名密钥（留空则每次启动随机生成）
SECRET_KEY=
# 演示账号口令：任何非本机部署必须覆盖
SEED_ADMIN_PASSWORD=demo-admin-change-me
SEED_WORKER_PASSWORD=demo-worker-change-me
DEFAULT_NEW_USER_PASSWORD=demo-user-change-me
# 演示手机号（100000000NN 为测试号段）
DEMO_ADMIN_PHONE=10000000001
DEMO_WORKER_PHONE=10000000010
DEMO_VOLUNTEER_PHONE=10000000006
DEMO_PARENT_PHONE=10000000011
DEMO_PENDING_PHONE=10000000014
# 演示账号一键登录：生产环境设为 0
ENABLE_DEMO_LOGIN=1
# 机构显示名称
ORG_NAME=示例公益机构
# 跨域白名单，逗号分隔；留空表示不开放跨域
CORS_ORIGINS=
# 服务端口（部署平台通常自动注入）
PORT=5000
